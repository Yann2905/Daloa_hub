# =========================================================================
# DALOA HUB - Variables d'environnement (stack Neon + Auth.js + Cloudinary)
# Copier ce fichier vers .env.local et renseigner les valeurs reelles.
# NE JAMAIS mettre de vrai mot de passe / cle ici (fichier versionne).
# =========================================================================

# --- Base de donnees Neon (neon.tech > Connect) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Authentification (Auth.js / NextAuth) ---
# Generer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=remplacer-par-un-secret-aleatoire
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DALOA HUB

# --- Geolocalisation / ville par defaut (Daloa) ---
NEXT_PUBLIC_DEFAULT_LAT=6.8772
NEXT_PUBLIC_DEFAULT_LNG=-6.4502
NEXT_PUBLIC_PROXIMITY_RADIUS_KM=3

# --- Abonnement vendeur ---
SUBSCRIPTION_AMOUNT_FCFA=1000
SUBSCRIPTION_PERIOD_DAYS=30

# --- Securite du cron ---
CRON_SECRET=remplacer-par-un-secret-aleatoire-long

# --- Cloudinary (upload images) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=daloa_hub_unsigned

# --- Push notifications (optionnel) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@daloahub.ci

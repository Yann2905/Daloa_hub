# =========================================================================
# DALOA HUB - Modele de variables d'environnement (AUCUN secret ici !)
# -------------------------------------------------------------------------
# Ce fichier est suivi par Git => ne JAMAIS y mettre de vraie valeur secrete.
#   - En LOCAL  : tes vraies valeurs vont dans .env.local (non suivi par Git).
#   - Sur VERCEL: tes vraies valeurs vont dans
#                 Settings > Environment Variables (Vercel ne lit PAS ce fichier).
# =========================================================================

# --- Base de donnees Neon (OBLIGATOIRE, identique local et Vercel) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Authentification Auth.js (OBLIGATOIRE) ---
AUTH_SECRET=remplacer-par-un-secret-aleatoire
# URL de base : http://localhost:3000 en local, https://ton-app.vercel.app en prod.
# (Sur Vercel, le plus simple est de NE PAS definir AUTH_URL : detection auto.)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DALOA HUB

# --- Geolocalisation / ville par defaut (Daloa) ---
NEXT_PUBLIC_DEFAULT_LAT=6.8772
NEXT_PUBLIC_DEFAULT_LNG=-6.4502
NEXT_PUBLIC_PROXIMITY_RADIUS_KM=3

# --- Abonnement vendeur ---
SUBSCRIPTION_AMOUNT_FCFA=1000
SUBSCRIPTION_PERIOD_DAYS=30

# --- Securite du cron ---
CRON_SECRET=remplacer-par-un-secret-aleatoire-long

# --- Cloudinary (upload images) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=daloa_hub_unsigned
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Emails transactionnels (Brevo / ex-Sendinblue, gratuit 300/jour) ---
# brevo.com > Settings > SMTP & API > API Keys (cle v3)
BREVO_API_KEY=
# Expediteur : DOIT etre un email/domaine verifie dans Brevo (Senders)
EMAIL_FROM=contact@ton-domaine.com
EMAIL_FROM_NAME=DALOA HUB
# SMS (optionnel) : nom expediteur (max 11 caracteres) + credits SMS Brevo
BREVO_SMS_SENDER=DALOAHUB

# --- Agent IA du service client (optionnel) ---
# Cle API Anthropic (console.anthropic.com). Sans elle, le service client
# repond un message d'attente et escalade vers un humain.
ANTHROPIC_API_KEY=
# Modele (defaut : claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=

# --- Suivi d'erreurs (Sentry, optionnel mais recommande) ---
# sentry.io > Project > Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Pour l'upload des source maps a la build (Settings > Auth Tokens) :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Notifications push Firebase Cloud Messaging (FCM, gratuit) ---
# Console Firebase > Parametres du projet > General > Vos applications (Web config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging > Certificats push Web (cle VAPID / paire de cles)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Compte de service (Parametres > Comptes de service > Generer une cle privee)
# OPTION A (recommandee, infaillible) : colle TOUT le contenu du fichier JSON
# telecharge dans cette seule variable.
FIREBASE_SERVICE_ACCOUNT=
# OPTION B : les 3 champs separes (si tu n'utilises pas l'option A)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Coller la cle entre guillemets, avec les \n litteraux conserves
FIREBASE_PRIVATE_KEY=
